---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Fusion BOP</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <nav class="site-nav" transition:persist="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="site-logo"><span class="logo-text">Fusion<span class="logo-bop">BoP</span></span><img src="/logo.png" alt="" class="site-logo-mark" /></a>
        <span class="beta-badge">Beta</span>

        <button id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>

        <div class="nav-links" id="nav-links">
          <a href="/" class="chamfer-panel chamfer-sm" aria-current={isCurrent('/') ? 'page' : undefined}><span>Overview</span></a>
          <a href="/thermo-background" class="chamfer-panel chamfer-sm" aria-current={isCurrent('/thermo-background') ? 'page' : undefined}><span>Thermodynamics Background</span></a>
          <a href="/tokamak-systems" class="chamfer-panel chamfer-sm" aria-current={isCurrent('/tokamak-systems') ? 'page' : undefined}><span>Tokamak Systems</span></a>
          <a href="/rankine" class="chamfer-panel chamfer-sm" aria-current={isCurrent('/rankine') ? 'page' : undefined}><span>H<sub>2</sub>O Rankine</span></a>
          <a href="/co2-brayton" class="chamfer-panel chamfer-sm" aria-current={isCurrent('/co2-brayton') ? 'page' : undefined}><span>CO<sub>2</sub>&nbsp;Brayton</span></a>
          <a href="/he-brayton" class="chamfer-panel chamfer-sm" aria-current={isCurrent('/he-brayton') ? 'page' : undefined}><span>He Brayton</span></a>
        </div>

        <span class="updated-badge">Updated August 2026</span>
      </div>
    </nav>
    <div class="nav-scrim" id="nav-scrim" transition:persist="nav-scrim"></div>
    <main class="p-6">
      <slot />
    </main>
  </body>
</html>

<script>
  // keeps --pct in sync with each range input's value for the webkit track fill
  function setFill(input: HTMLInputElement) {
    const min = parseFloat(input.min) || 0;
    const max = parseFloat(input.max) || 100;
    const pct = ((parseFloat(input.value) - min) / (max - min)) * 100;
    input.style.setProperty('--pct', pct + '%');
  }

  function attach(input: HTMLInputElement) {
    if ((input as any)._sf) return;
    (input as any)._sf = true;
    requestAnimationFrame(() => setFill(input));
    input.addEventListener('input', () => setFill(input));
  }

  const mo = new MutationObserver(ms => {
    for (const m of ms)
      for (const n of m.addedNodes as NodeListOf<Element>)
        if (n.nodeType === 1) {
          if ((n as Element).matches?.('input[type="range"]')) attach(n as HTMLInputElement);
          (n as Element).querySelectorAll?.('input[type="range"]').forEach(el => attach(el as HTMLInputElement));
        }
  });
  mo.observe(document.documentElement, { childList: true, subtree: true });
  document.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(attach);

  // hamburger toggles a slide-in panel, closed by the scrim, a nav link click, or escape
  const navToggle = document.getElementById('nav-toggle');
  const navLinks  = document.getElementById('nav-links');
  const navScrim  = document.getElementById('nav-scrim');

  function setNavOpen(open: boolean) {
    navLinks?.classList.toggle('open', open);
    navScrim?.classList.toggle('open', open);
    navToggle?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-lock', open);
  }

  navToggle?.addEventListener('click', () => {
    setNavOpen(!navLinks?.classList.contains('open'));
  });
  navScrim?.addEventListener('click', () => setNavOpen(false));
  navLinks?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setNavOpen(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setNavOpen(false); });

  // nav persists across client-side navigations, so aria-current goes stale.
  // recompute it after each page swap.
  function updateCurrentLink() {
    const path = location.pathname;
    navLinks?.querySelectorAll('a').forEach(a => {
      const href = a.getAttribute('href') ?? '';
      const current = path === href || (href !== '/' && path.startsWith(href));
      if (current) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  document.addEventListener('astro:page-load', () => {
    updateCurrentLink();
    setNavOpen(false);
  });
</script>

<style is:global>
  .site-nav {
    position: relative;
    padding: 0.55rem 1.5rem;
    min-height: 54px;
    background-image:
      linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 40%),
      linear-gradient(180deg, var(--steel-650), var(--steel-800)),
      var(--aluminum);
    background-repeat: no-repeat, no-repeat, no-repeat;
    background-size: 100% 100%, 100% 100%, cover;
    background-position: center, center, center;
    background-blend-mode: normal, overlay, normal;
    border-bottom: 1px solid var(--hairline);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12), inset 0 -1px 0 rgba(255, 255, 255, 0.5);
  }

  /* constrains nav content to the same width as .page-container so the logo
     and page titles share one left edge. the bar itself stays full width. */
  .site-nav-inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }

  .site-nav .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--paper);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
    text-decoration: none;
    margin-right: 0.75rem;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .site-nav .site-logo:hover  { opacity: 0.7; }
  .site-nav .site-logo:active { opacity: 0.45; transform: translateY(1px); }

  .site-nav .logo-bop { color: var(--teal-dim); }
  .site-nav .site-logo-mark { height: 1.35em; width: auto; display: block; }

  /* recessed, not raised: inset shadow from the top lip, light catch at the bottom.
     no texture image of its own either, a scaled copy of the nav's aluminum grain
     would render at the wrong scale. a transparent tint gradient lets the nav's own
     texture show through underneath at the right scale instead. */
  .beta-badge, .updated-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
    background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.16), transparent 45%, rgba(255, 255, 255, 0.16));
    border: 1px solid rgba(20, 24, 26, 0.2);
    border-radius: 999px;
    /* right padding trimmed by the letter-spacing value, otherwise the trailing
       gap after the last character leaves the text looking shifted left. */
    padding: 0.2rem calc(0.6rem - 0.1em) 0.2rem 0.6rem;
    white-space: nowrap;
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.45), inset 0 -1px 0 rgba(255, 255, 255, 0.4);
  }
  .beta-badge { margin-right: 0.9rem; }
  .updated-badge { margin-left: auto; }
  @media (max-width: 1279px) {
    .updated-badge { display: none; }
  }

  .site-nav .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  /* same chamfered metal chip chrome as the reset button in RankineCycle.svelte.
     a persistent raised chip, not just a hover pill. */
  .site-nav .nav-links a {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease, filter 0.15s ease;
  }

  .site-nav .nav-links a:hover {
    color: var(--teal-dim);
    filter: brightness(1.08);
  }
  /* brief teal glow flash on click, same teal as "BoP" in the logo */
  .site-nav .nav-links a:active {
    transform: translateY(1px);
    filter: brightness(0.94);
    color: var(--teal-dim);
    text-shadow: 0 0 10px var(--teal), 0 0 2px var(--teal);
    transition: transform 0.1s ease, filter 0.1s ease, text-shadow 0.05s ease;
  }
  /* current page gets teal color only, no glow. glow stays reserved for the click flash. */
  .site-nav .nav-links a[aria-current="page"] {
    color: var(--teal-dim);
  }
  .site-nav .nav-links a[aria-current="page"]:hover {
    color: var(--teal-dim);
  }

  /* hamburger toggle, hidden above the breakpoint, replaces nav link wrapping below it */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    margin-left: auto;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--paper);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 40;
  }
  .nav-scrim.open { opacity: 1; pointer-events: auto; }

  body.nav-lock { overflow: hidden; }

  /* breakpoint sits just above where the link row stops fitting on one line.
     below it, links move into the slide-in panel instead of wrapping into two rows. */
  @media (max-width: 1140px) {
    .site-nav .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: min(280px, 80vw);
      background-image:
        linear-gradient(165deg, var(--steel-650), var(--steel-900)),
        var(--aluminum);
      background-repeat: no-repeat, no-repeat;
      background-size: 100% 100%, cover;
      background-position: center, center;
      background-blend-mode: overlay, normal;
      border-left: 1px solid var(--hairline);
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0.25rem;
      padding: 4.5rem 1.25rem 1.5rem;
      box-shadow: -8px 0 28px rgba(0, 0, 0, 0.5);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 50;
      overflow-y: auto;
    }
    .site-nav .nav-links.open { transform: translateX(0); }
    .site-nav .nav-links a { width: 100%; margin-bottom: 0.35rem; justify-content: center; }
    .nav-toggle { display: flex; }
  }
</style>
