---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarnotCycle from '../components/CarnotCycle.svelte';
import EntropySimulator from '../components/EntropySimulator.svelte';
---
<BaseLayout title="Thermodynamics Background">
  <div class="page-container">
    <h1 class="text-3xl font-bold mb-4">Thermodynamics Background</h1>
    <p class="mb-8">Static background content goes here.</p>
  </div>

  <div class="simulator-box chamfer-panel chamfer-all" style="max-width: 900px;">
    <h2 class="page-title">The Carnot Cycle</h2>
    <!-- plain div, not CarnotCycle directly. astro's own astro-island wrapper
         is display:contents, so chamfer-panel's z-index promotion no-ops on it. -->
    <div><CarnotCycle client:load /></div>
  </div>

  <div class="simulator-box chamfer-panel chamfer-all" style="max-width: 980px;">
    <h2 class="page-title">Entropy Simulator</h2>
    <!-- plain div wrapper, see the carnot box above for the astro-island reason -->
    <div><EntropySimulator client:load /></div>
  </div>
</BaseLayout>