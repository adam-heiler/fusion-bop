---
import BaseLayout from '../layouts/BaseLayout.astro';
import CO2BraytonCycle from '../components/CO2BraytonCycle.svelte';
---
<BaseLayout title="CO2 Brayton">
  <div class="page-container">
    <h2 class="page-title">CO<sub>2</sub> Brayton Cycle</h2>
  </div>
  <div class="page-breakout">
    <img class="cycle-diagram diagram-co2" src="/diagrams/fusion-co2-brayton.png" alt="Process flow diagram of the supercritical CO2 recompression Brayton cycle balance of plant" width="1653" height="800" />
  </div>
  <div class="simulator-box chamfer-panel chamfer-all">
    <!-- plain div, not CO2BraytonCycle directly. astro's own astro-island wrapper
         is display:contents, so chamfer-panel's z-index promotion no-ops on it. -->
    <div><CO2BraytonCycle client:load /></div>
  </div>
</BaseLayout>

<style>
  /* sized off this diagram's native resolution, same scale factor as the
     rankine and he diagrams so labels read at a consistent size across all three. */
  .diagram-co2 { max-width: 1050px; }
</style>