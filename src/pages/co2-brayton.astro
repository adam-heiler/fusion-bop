---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="CO2 Brayton">
  <div style="max-width: 1700px; margin: 0 auto;">
    <p class="mb-6" style="color: #8b948c; font-size: 14px;">
      Supercritical CO<sub>2</sub> recompression Brayton cycle: primary and recompression
      compressors, high-/low-temperature recuperators, dry-cooled precooler. Interactive
      simulator coming soon.
    </p>
    <div class="drafting-mat chamfer-panel chamfer-all" style="max-width: 1144px; margin: 0 auto 28px;">
      <div class="drafting-panel">
        <span class="drafting-frame"></span>
        <span class="drafting-corner tl"></span>
        <span class="drafting-corner tr"></span>
        <span class="drafting-corner bl"></span>
        <span class="drafting-corner br"></span>
        <img src="/diagrams/fusion-co2-brayton.png" alt="Process flow diagram of the supercritical CO2 recompression Brayton cycle balance of plant" />
        <div class="drafting-titleblock">
          <div class="tb-title">
            <span class="tb-line1">FUSION BOP</span>
            <span class="tb-line2">CO<sub>2</sub> BRAYTON CYCLE PROCESS FLOW DIAGRAM</span>
          </div>
          <div class="tb-meta">
            <div class="tb-row"><span class="tb-key">DWG NO.</span><span class="tb-val">CO2BRAY&#8209;01</span></div>
            <div class="tb-row"><span class="tb-key">REV</span><span class="tb-val">A</span></div>
            <div class="tb-row"><span class="tb-key">SCALE</span><span class="tb-val">NTS</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>