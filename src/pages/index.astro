---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Overview">
  <section class="hero">
    <div class="hero-heading">
      <span class="hero-heading-text">Welcome to <span class="hero-brand"><span class="hero-fusion">Fusion</span><span class="hero-bop"><span class="bop-letter bop-letter-1">B</span><span class="bop-letter bop-letter-2">o</span><span class="bop-letter bop-letter-3">P</span></span></span></span>
      <img src="/logo.png" alt="" class="hero-logo-mark" />
    </div>

    <div class="hero-flow">
      <div class="hero-side hero-side-left">
        <img src="/other_images/hires-tokamak.png" alt="Tokamak plasma cross-section" class="hero-art" width="2500" height="2074" />
        <div class="flow-pipe"></div>
      </div>

      <div class="bop-node-frame">
        <div class="bop-node-glow"></div>
        <div class="bop-node chamfer-panel chamfer-all">
          <span class="bop-node-label">
            <span class="bop-node-line"><span class="bop-node-letter bop-letter-1">B</span>alance</span>
            <span class="bop-node-line"><span class="bop-node-letter bop-letter-2">O</span>f</span>
            <span class="bop-node-line"><span class="bop-node-letter bop-letter-3">P</span>lant</span>
          </span>
        </div>
      </div>

      <div class="hero-side hero-side-right">
        <div class="flow-pipe"></div>
        <img src="/other_images/hires-powerline.png" alt="Power transmission line" class="hero-art hero-art-powerline" width="1935" height="2500" />
        <img src="/other_images/hires-powerline.png" alt="" class="hero-art hero-art-powerline hero-art-powerline-2" width="1935" height="2500" />
      </div>
    </div>
  </section>
  <div class="hero-bottom-bar"></div>

  <div class="construction-notice chamfer-panel chamfer-sm chamfer-all">
    <div class="construction-stripe" aria-hidden="true"></div>
    <div class="construction-copy">
      <p class="construction-title">Under Construction</p>
      <p class="construction-text">This Overview page is still being built out. More is coming soon.</p>
    </div>
  </div>

  <div class="about-box">
    <figure class="about-photo-fig">
      <img src="/other_images/me-cooling-tower.jpg" alt="Adam Heiler standing in front of a cooling tower at Nine Mile Point Clean Energy Center" class="about-photo" width="2638" height="3518" />
      <figcaption class="photo-caption">Me in front of Nine Mile Point Unit 2's 543-foot cooling tower</figcaption>
    </figure>
    <div class="about-text">
      <div class="about-bio">
        <p class="about-greeting">Hello! I am Adam Heiler</p>
        <p>I'm a senior mechanical engineering undergraduate student at the University of Michigan, and as I'm sure you can probably tell, I love clean energy and thermodynamics.</p>
        <p>I have spent these past two summers interning with the Balance of Plant team at Nine Mile Point, a two-unit nuclear power plant on Lake Ontario in New York State. I am also the Technical Director of SPARK Electric Racing, University of Michigan's electric motorcycle project team.</p>
        <p>I love my dogs, exploring new cities, hiking, going to Michigan football games, playing piano, learning guitar, and drumming in Groove Percussion and Performance Group.</p>
        <p>Enjoy my website!</p>
      </div>
      <figure class="ann-arbor-fig">
        <div class="ann-arbor-frame">
          <img src="/other_images/ann-arbor.jpg" alt="Ann Arbor and University of Michigan skyline" class="ann-arbor-photo" width="4032" height="972" />
        </div>
        <figcaption class="photo-caption">Ann Arbor as seen from Michigan Stadium</figcaption>
      </figure>
    </div>
  </div>
</BaseLayout>

<style>
  /* full-bleed hero; overflow hidden stops the bop node glow from growing page height */
  .hero {
    position: relative;
    overflow: hidden;
    margin: -24px -24px 0;
    padding: 44px max(24px, calc(50vw - 640px));
    background-image:
      linear-gradient(180deg, rgba(53, 214, 180, 0.11), rgba(53, 214, 180, 0) 88%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 42%),
      linear-gradient(163deg, var(--steel-300), var(--steel-500) 85%);
    background-blend-mode: normal;
    background-size: cover;
    background-position: center;
  }

  /* brushed-metal strip matching the nav bar's chamfer-panel rim weight */
  .hero-bottom-bar {
    position: relative;
    isolation: isolate;
    height: 16px;
    margin: 0 -24px;
    background-image:
      linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 40%),
      linear-gradient(180deg, var(--steel-650), var(--steel-800));
    background-repeat: no-repeat, no-repeat;
    background-size: 100% 100%, 100% 100%;
    background-position: center, center;
    border-top: 1.5px solid var(--steel-900);
    border-bottom: 1.5px solid var(--steel-900);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.5), inset 0 -1px 0 rgba(255, 255, 255, 0.5);
  }
  /* aluminum grain: two copies of the same fixed-width tile, offset by half
     a tile and cross-faded between - see BaseLayout.astro's .site-nav. */
  .hero-bottom-bar::before,
  .hero-bottom-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--aluminum);
    background-repeat: repeat-x;
    background-size: 900px auto;
    background-position: 0 center;
    mix-blend-mode: overlay;
    pointer-events: none;
    -webkit-mask-image: repeating-linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-image: repeating-linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
    -webkit-mask-size: 900px 100%;
    mask-size: 900px 100%;
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    -webkit-mask-position: 0 center;
    mask-position: 0 center;
  }
  .hero-bottom-bar::after {
    background-position: 450px center;
    -webkit-mask-position: 450px center;
    mask-position: 450px center;
  }

  .hero-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .hero-logo-mark { height: 44px; width: auto; }
  .hero-heading-text {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.8vw, 46px);
    font-weight: 700;
    color: var(--paper);
    white-space: nowrap;
  }
  .hero-brand { white-space: nowrap; }
  .hero-fusion, .hero-bop {
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hero-fusion { color: var(--paper); }

  /* longhand animation props, not shorthand, so animation-delay isn't reset */
  .bop-letter {
    display: inline-block;
    color: var(--teal-dim);
    animation-name: bop-letter-glow;
    animation-duration: 2.4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .bop-letter-1 { animation-delay: 0s; }
  .bop-letter-2 { animation-delay: 0.8s; }
  .bop-letter-3 { animation-delay: 1.6s; }
  /* white flash reads as the letter lighting up, not vanishing */
  @keyframes bop-letter-glow {
    0%, 12%, 100% { color: var(--teal-dim); text-shadow: none; }
    6% { color: #ffffff; text-shadow: 0 0 4px var(--teal), 0 0 1px rgba(255, 255, 255, 0.9); }
  }

  /* three equal columns keep the bop node centered regardless of art width */
  .hero-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }
  .hero-side {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .hero-side-left { justify-content: flex-end; }
  .hero-side-right { justify-content: flex-start; }
  .hero-art {
    width: auto;
    height: clamp(160px, 22vw, 320px);
    flex-shrink: 0;
  }
  /* narrow crop sized up against the tokamak; both towers share a ground line */
  .hero-art-powerline { height: clamp(200px, 27vw, 400px); align-self: flex-end; transform: translateX(-6.77%); }
  /* shorter, tucked in close, reads as set further back */
  .hero-art-powerline-2 {
    height: clamp(110px, 15vw, 230px);
    align-self: flex-end;
    margin-left: clamp(-74px, -5vw, -44px);
    margin-bottom: clamp(16px, 4vw, 54px);
  }

  /* moving dashed line, fixed width so both sides match */
  .flow-pipe {
    flex: none;
    width: clamp(50px, 6vw, 110px);
    height: 3px;
    margin: 0 4px;
    background-image: repeating-linear-gradient(90deg, var(--teal) 0 12px, transparent 12px 24px);
    background-size: 48px 3px;
    animation: flow-move 1.2s linear infinite;
  }
  @keyframes flow-move {
    to { background-position: 48px 0; }
  }

  /* glow ring peeks through a gap, clipped to the chamfer so it never escapes it */
  .bop-node-frame {
    position: relative;
    flex-shrink: 0;
    --cf: 14px;
    width: calc(clamp(160px, 18vw, 260px) + 6px);
    margin: 0 6px;
    padding: 3px;
    clip-path: polygon(
      var(--cf) 0, calc(100% - var(--cf)) 0,
      100% var(--cf), 100% calc(100% - var(--cf)),
      calc(100% - var(--cf)) 100%, var(--cf) 100%,
      0 calc(100% - var(--cf)), 0 var(--cf)
    );
  }
  .bop-node-glow {
    position: absolute;
    inset: -75%;
    background: conic-gradient(from 0deg, transparent 0 72%, rgba(53, 214, 180, 0.25) 82%, var(--teal) 94%, transparent 100%);
    animation: bop-ring-spin 3.2s linear infinite;
  }
  @keyframes bop-ring-spin {
    to { transform: rotate(360deg); }
  }
  .bop-node {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 16px 26px;
  }
  .bop-node-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bop-node-line {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: left;
    color: var(--paper);
    line-height: 1.25;
    white-space: nowrap;
  }
  /* first letter of each line is bigger and teal, matches the heading's flash timing. */
  .bop-node-letter {
    display: inline-block;
    font-size: 1.2em;
    line-height: 1;
    vertical-align: baseline;
    color: var(--teal-dim);
    animation-name: bop-node-letter-glow;
    animation-duration: 2.4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  /* same flash color as the heading. */
  @keyframes bop-node-letter-glow {
    0%, 12%, 100% { color: var(--teal-dim); text-shadow: none; }
    6% { color: #ffffff; text-shadow: 0 0 4px var(--teal), 0 0 1px rgba(255, 255, 255, 0.9); }
  }

  @media (max-width: 720px) {
    .hero { padding: 32px 20px; }
    .hero-heading { text-align: center; flex-wrap: nowrap; gap: 6px; }
    .hero-heading-text { font-size: clamp(15px, 6vw, 46px); }
    .hero-logo-mark { height: clamp(18px, 6vw, 44px); }

    .hero-flow {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .hero-side, .hero-side-left, .hero-side-right {
      display: contents;
    }
    .hero-art-powerline-2 { display: none; }
    .hero-art { height: clamp(210px, 52vw, 300px); }
    .hero-art-powerline { height: clamp(230px, 58vw, 330px); align-self: center; margin-bottom: 0; }

    .flow-pipe {
      width: 3px; height: 28px; flex: none; margin: 0;
      background-image: repeating-linear-gradient(180deg, var(--teal) 0 12px, transparent 12px 24px);
      background-size: 3px 48px;
      animation: flow-move-v 1.2s linear infinite;
    }
    @keyframes flow-move-v { to { background-position: 0 48px; } }
    .bop-node-frame { width: 220px; height: auto; }
    .bop-node { height: auto; padding: 18px 22px; }
    .bop-node-line { font-size: 22px; }
  }

  /* always visible, not the dev-only overlay */
  .construction-notice {
    position: relative;
    max-width: 1028px;
    margin: 24px auto 0;
    padding: 14px 20px;
    overflow: hidden;
  }
  .construction-stripe {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--amber) 0 10px,
      var(--paper) 10px 20px
    );
  }
  .construction-copy { min-width: 0; }
  .construction-title {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--paper);
  }
  .construction-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-dim);
  }

  /* matches .rankine-align's content width (simulator-box's 1100px minus its 72px padding).

     Bottom alignment, done properly this time: two independently-sized images with
     preserved aspect ratios cannot be guaranteed to end at the same pixel at every
     viewport width - the columns don't scale in a fixed ratio to each other (one is
     capped at 400px, the other fills whatever's left), so no fixed offset or margin
     trick holds outside the one width it was measured at. The only width-independent
     fix is to let one image's *frame* be sized by layout (not by its own aspect ratio)
     and crop into it. The cooling tower photo is never touched - full aspect ratio,
     always. The Ann Arbor frame instead fills whatever vertical space is left after
     the bio text, cropping the (already-zoomed) wide panorama via object-fit to match
     - at any viewport width, automatically, because it's real CSS layout doing the
     matching instead of a guessed number. */
  .about-box {
    display: grid;
    grid-template-columns: minmax(260px, 400px) minmax(0, 1fr);
    gap: 28px;
    align-items: stretch;
    max-width: 1028px;
    margin: 32px auto 0;
  }
  .about-photo-fig { margin: 0; }
  .about-photo {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hairline);
    filter: drop-shadow(0 4px 10px rgba(20, 24, 26, 0.16));
  }
  .photo-caption {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--ink-dim);
    text-align: center;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-family: var(--font-display);
    color: var(--paper);
  }
  .about-bio { flex: none; }
  .about-bio p {
    margin: 0 0 14px;
    line-height: 1.6;
  }
  .about-bio p:last-child { margin-bottom: 0; }
  .about-greeting {
    font-size: 20px;
    font-weight: 700;
  }

  /* fills whatever height is left in the stretched .about-text column after the bio */
  .ann-arbor-fig {
    flex: 1 1 auto;
    min-height: 80px;
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .ann-arbor-frame {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    filter: drop-shadow(0 4px 10px rgba(20, 24, 26, 0.16));
  }
  .ann-arbor-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* below this, the bio text wraps enough in the narrowed 1fr column to grow taller
     than the photo, and the alignment guarantee above only holds when the photo is
     the taller column - measured the actual breakpoint directly (broken from 640px
     up to ~1050px), not guessed. */
  @media (max-width: 1060px) {
    .about-box {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: left;
    }
    .about-photo { max-width: 320px; }
    .ann-arbor-fig { min-height: 160px; }
  }
</style>
