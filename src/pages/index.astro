---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Overview">
  <section class="hero">
    <div class="hero-heading">
      <span class="hero-heading-text">Welcome to <span class="hero-brand"><span class="hero-fusion">Fusion</span><span class="hero-bop"><span class="bop-letter bop-letter-1">B</span><span class="bop-letter bop-letter-2">o</span><span class="bop-letter bop-letter-3">P</span></span></span></span>
      <img src="/logo.png" alt="" class="hero-logo-mark" />
    </div>

    <div class="hero-flow">
      <div class="hero-side hero-side-left">
        <img src="/other_images/hires-tokamak.png" alt="Tokamak plasma cross-section" class="hero-art" width="2500" height="2074" />
        <div class="flow-pipe"></div>
      </div>

      <div class="bop-node-frame">
        <div class="bop-node-glow"></div>
        <div class="bop-node chamfer-panel chamfer-all">
          <span class="bop-node-label">
            <span class="bop-node-line"><span class="bop-node-letter bop-letter-1">B</span>alance</span>
            <span class="bop-node-line"><span class="bop-node-letter bop-letter-2">O</span>f</span>
            <span class="bop-node-line"><span class="bop-node-letter bop-letter-3">P</span>lant</span>
          </span>
        </div>
      </div>

      <div class="hero-side hero-side-right">
        <div class="flow-pipe"></div>
        <img src="/other_images/hires-powerline.png" alt="Power transmission line" class="hero-art hero-art-powerline" width="1935" height="2500" />
        <img src="/other_images/hires-powerline.png" alt="" class="hero-art hero-art-powerline hero-art-powerline-2" width="1935" height="2500" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* full-bleed hero, breaks out of the page padding to sit flush against the nav.
     overflow hidden stops the spinning bop node glow from growing page height. */
  .hero {
    position: relative;
    overflow: hidden;
    margin: -24px calc(-50vw + 50%) 0;
    padding: 44px max(24px, calc(50vw - 640px));
    background-image:
      linear-gradient(0deg, rgba(53, 214, 180, 0.2), rgba(53, 214, 180, 0) 40%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 42%),
      linear-gradient(163deg, var(--steel-300), var(--steel-600) 85%);
    background-blend-mode: normal;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--hairline);
  }

  .hero-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .hero-logo-mark { height: 44px; width: auto; }
  .hero-heading-text {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.8vw, 46px);
    font-weight: 700;
    color: var(--paper);
    white-space: nowrap;
  }
  .hero-brand { white-space: nowrap; }
  .hero-fusion, .hero-bop {
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hero-fusion { color: var(--paper); }

  /* bop letters flash teal in sequence, looping.
     longhand animation properties, not the shorthand, so animation-delay isn't reset. */
  .bop-letter {
    display: inline-block;
    color: var(--teal-dim);
    animation-name: bop-letter-glow;
    animation-duration: 2.4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .bop-letter-1 { animation-delay: 0s; }
  .bop-letter-2 { animation-delay: 0.8s; }
  .bop-letter-3 { animation-delay: 1.6s; }
  /* white flash reads as the letter lighting up instead of vanishing on the light panel.
     same keyframe shape reused below for the bop node letters. */
  @keyframes bop-letter-glow {
    0%, 12%, 100% { color: var(--teal-dim); text-shadow: none; }
    6% { color: #ffffff; text-shadow: 0 0 4px var(--teal), 0 0 1px rgba(255, 255, 255, 0.9); }
  }

  /* three equal columns so the bop node stays centered under the heading
     regardless of the art widths on each side. */
  .hero-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }
  .hero-side {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .hero-side-left { justify-content: flex-end; }
  .hero-side-right { justify-content: flex-start; }
  .hero-art {
    width: auto;
    height: clamp(160px, 22vw, 320px);
    flex-shrink: 0;
  }
  /* powerline art is a narrow crop, sized up so it holds its own against the tokamak.
     both towers bottom-align to a shared ground line. */
  .hero-art-powerline { height: clamp(200px, 27vw, 400px); align-self: flex-end; transform: translateX(-6.77%); }
  /* second tower is shorter and tucked in close, lifted a bit to read as set further back. */
  .hero-art-powerline-2 {
    height: clamp(110px, 15vw, 230px);
    align-self: flex-end;
    margin-left: clamp(-74px, -5vw, -44px);
    margin-bottom: clamp(16px, 4vw, 54px);
  }

  /* moving dashed line between the art and the bop node.
     fixed width so both sides stay the same length. */
  .flow-pipe {
    flex: none;
    width: clamp(50px, 6vw, 110px);
    height: 3px;
    margin: 0 4px;
    background-image: repeating-linear-gradient(90deg, var(--teal) 0 12px, transparent 12px 24px);
    background-size: 48px 3px;
    animation: flow-move 1.2s linear infinite;
  }
  @keyframes flow-move {
    to { background-position: 48px 0; }
  }

  /* bop node is a light chamfered plate, landscape shape so the label has room.
     border is a spinning glow ring peeking through a small gap around the plate,
     clipped to the same chamfer shape so it never escapes the outline. */
  .bop-node-frame {
    position: relative;
    flex-shrink: 0;
    --cf: 14px;
    width: calc(clamp(160px, 18vw, 260px) + 6px);
    margin: 0 6px;
    padding: 3px;
    clip-path: polygon(
      var(--cf) 0, calc(100% - var(--cf)) 0,
      100% var(--cf), 100% calc(100% - var(--cf)),
      calc(100% - var(--cf)) 100%, var(--cf) 100%,
      0 calc(100% - var(--cf)), 0 var(--cf)
    );
  }
  .bop-node-glow {
    position: absolute;
    inset: -75%;
    background: conic-gradient(from 0deg, transparent 0 72%, rgba(53, 214, 180, 0.25) 82%, var(--teal) 94%, transparent 100%);
    animation: bop-ring-spin 3.2s linear infinite;
  }
  @keyframes bop-ring-spin {
    to { transform: rotate(360deg); }
  }
  .bop-node {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 16px 26px;
  }
  .bop-node-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bop-node-line {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: left;
    color: var(--paper);
    line-height: 1.25;
    white-space: nowrap;
  }
  /* first letter of each line is bigger and teal, matches the heading's flash timing. */
  .bop-node-letter {
    display: inline-block;
    font-size: 1.2em;
    line-height: 1;
    vertical-align: baseline;
    color: var(--teal-dim);
    animation-name: bop-node-letter-glow;
    animation-duration: 2.4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  /* same flash color as the heading. */
  @keyframes bop-node-letter-glow {
    0%, 12%, 100% { color: var(--teal-dim); text-shadow: none; }
    6% { color: #ffffff; text-shadow: 0 0 4px var(--teal), 0 0 1px rgba(255, 255, 255, 0.9); }
  }

  @media (max-width: 720px) {
    .hero { padding: 32px 20px; }
    .hero-heading { text-align: center; flex-wrap: nowrap; gap: 6px; }
    .hero-heading-text { font-size: clamp(15px, 6vw, 46px); }
    .hero-logo-mark { height: clamp(18px, 6vw, 44px); }

    .hero-flow {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .hero-side, .hero-side-left, .hero-side-right {
      display: contents;
    }
    .hero-art-powerline-2 { display: none; }
    .hero-art { height: clamp(210px, 52vw, 300px); }
    .hero-art-powerline { height: clamp(230px, 58vw, 330px); align-self: center; margin-bottom: 0; }

    .flow-pipe {
      width: 3px; height: 28px; flex: none; margin: 0;
      background-image: repeating-linear-gradient(180deg, var(--teal) 0 12px, transparent 12px 24px);
      background-size: 3px 48px;
      animation: flow-move-v 1.2s linear infinite;
    }
    @keyframes flow-move-v { to { background-position: 0 48px; } }
    .bop-node-frame { width: 220px; height: auto; }
    .bop-node { height: auto; padding: 18px 22px; }
    .bop-node-line { font-size: 22px; }
  }
</style>
