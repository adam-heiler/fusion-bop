---
import BaseLayout from '../layouts/BaseLayout.astro';
import RankineCycle from '../components/RankineCycle.svelte';
---
<BaseLayout title="H2O Rankine">
  <div style="max-width: 1700px; margin: 0 auto;">
    <p class="mb-6" style="color: #8b948c; font-size: 14px;">
      250 bar supercritical reheat regenerative cycle: 6 closed feedwater heaters,
      deaerator, 7 extraction bleeds, cooling-tower condenser. Heat duty Q = 1000 MW fixed.
    </p>
    <div class="drafting-mat chamfer-panel chamfer-all">
      <div class="drafting-panel">
        <span class="drafting-frame"></span>
        <span class="drafting-corner tl"></span>
        <span class="drafting-corner tr"></span>
        <span class="drafting-corner bl"></span>
        <span class="drafting-corner br"></span>
        <img src="/diagrams/fusion-rankine.png" alt="Process flow diagram of the supercritical reheat regenerative Rankine cycle balance of plant" />
        <div class="drafting-titleblock">
          <div class="tb-title">
            <span class="tb-line1">FUSION BOP</span>
            <span class="tb-line2">H<sub>2</sub>O RANKINE CYCLE PROCESS FLOW DIAGRAM</span>
          </div>
          <div class="tb-meta">
            <div class="tb-row"><span class="tb-key">DWG NO.</span><span class="tb-val">RANKINE&#8209;01</span></div>
            <div class="tb-row"><span class="tb-key">REV</span><span class="tb-val">A</span></div>
            <div class="tb-row"><span class="tb-key">SCALE</span><span class="tb-val">NTS</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div style="max-width: 1100px; margin: 0 auto;">
    <RankineCycle client:only="svelte" />
  </div>
</BaseLayout>
